# .env.example → .env 로 복사해서 사용 (계획서 17.3)
# .env 파일은 절대 커밋하지 않는다.

# local: 가짜 로그인 + 메모리 저장소 / firebase: 실제 로그인 + Firestore
APP_MODE=local

# 로컬 모드의 기본 역할: registrar | reviewer | admin
DEV_ROLE=reviewer

# Firebase (APP_MODE=firebase 일 때 필요, 값은 팀장에게 1:1로 받는다)
FIREBASE_WEB_API_KEY=
# 서비스 계정 키는 저장소 밖에 둔다 (전체 경로로 적는다, ~ 사용 불가)
#   Mac:     /Users/본인계정/.config/edu-web-pacs/sa-이름.json
#   Windows: C:\Users\본인계정\.config\edu-web-pacs\sa-이름.json
#   JCloud:  /srv/dermapacs/secrets/sa-server.json
GOOGLE_APPLICATION_CREDENTIALS=/Users/본인계정/.config/edu-web-pacs/sa-이름.json

# 원본·결과·특징 파일 위치 (JCloud는 /srv/dermapacs/data)
DATA_DIR=./data_local

# 1이면 local 모드로는 앱이 시작되지 않는다 (JCloud에서는 반드시 1)
DEPLOY=0
